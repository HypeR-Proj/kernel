{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "kernel",
  "kind": "kernel",
  "origin": {
    "repository": "https://github.com/roolrz/HypeR",
    "commit": "8d42d047058a2b58a291803700e86487fb723f7a"
  },
  "packages": [],
  "tests": [
    [
      "sh",
      "{component}/tests/ci/module.sh"
    ]
  ],
  "config": {
    "schema": "Kconfig",
    "defaults": "configs/qemu_{arch}_defconfig",
    "menu": [
      "make",
      "-C",
      "{source}",
      "menuconfig",
      "CONFIG_FILE={config}",
      "ARCH={arch}"
    ]
  },
  "build": {
    "makefile": "mk/build.mk",
    "actions": {
      "*": [
        [
          "make",
          "-C",
          "{source}",
          "{action}",
          "CONFIG_FILE={config}",
          "ARCH={arch}"
        ]
      ]
    }
  }
}
